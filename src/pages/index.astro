---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalcSearch from '../components/ui/CalcSearch.tsx';
import CountUp from '../components/ui/CountUp.tsx';
import { calculators, popularCalculators, categoryMeta, calculatorsByCategory, type CalcCategory } from '../data/calculators';
import { buildFAQSchema, buildWebsiteSchema, buildOrganizationSchema, SITE } from '../lib/seo';
import { totalCalculatorCount } from '../data/calculators';

const totalCount = totalCalculatorCount;

// Marquee items — featured calculators that scroll in the strip
const marqueeItems = [
  '🏠 Mortgage Calculator', '💰 Tax Calculator', '⚖️ BMI Calculator', '📈 SIP Calculator', '💱 Currency Converter', '🔥 TDEE Calculator',
  '🇮🇳 EMI Calculator', '🎂 Age Calculator', '🧮 Percentage Calculator', '🧱 Concrete Calculator', '🍽️ Tip Calculator', '💪 Body Fat Calculator',
  '🍎 Calorie Calculator', '📆 Date Calculator', '🌡️ Temperature Converter', '🪙 Income Tax Calculator', '💼 Salary Calculator',
];

const useCases = [
  {
    title: 'Buying a home?',
    icon: '🏠',
    desc: 'Estimate your monthly mortgage payment, compare loan terms and plan your down payment.',
    cta: 'Mortgage Calculator',
    href: '/finance/mortgage-calculator/',
    chipColor: 'chip-lime',
  },
  {
    title: 'Tracking fitness?',
    icon: '💪',
    desc: 'Check BMI, daily calorie needs and macros to reach your goals.',
    cta: 'BMI Calculator',
    href: '/health/bmi-calculator/',
    chipColor: 'chip-pink',
  },
  {
    title: 'Investing for the future?',
    icon: '📈',
    desc: 'See how compound interest and SIP returns build wealth over time.',
    cta: 'SIP Calculator',
    href: '/finance/sip-calculator/',
    chipColor: 'chip-yellow',
  },
  {
    title: 'Filing taxes in India?',
    icon: '🪙',
    desc: 'Compare the old and new tax regime with state-wise professional tax.',
    cta: 'Old vs New Tax Regime Calculator',
    href: '/finance/old-vs-new-tax-regime-india/',
    chipColor: 'chip-cyan',
  },
];

const faqs = [
  {
    q: 'Are all calculators really free?',
    a: 'Yes. Every calculator on FreeCalculations is 100% free to use, with no signup, no email gate and no premium tier. We keep the site free with ads, and we never sell your personal data.',
  },
  {
    q: 'How accurate are the calculators?',
    a: 'We use standard, widely accepted formulas and test each calculator against known results. Results are estimates for planning and information only, so check important financial, tax or medical decisions with a qualified professional.',
  },
  {
    q: 'Is my data private?',
    a: "Yes. Calculations run in your browser, and we don't ask you to create an account or share personal details.",
  },
  {
    q: 'Do the calculators work on phones?',
    a: 'Yes. All calculators are mobile-first and work on any phone, tablet or desktop browser, with no app to install.',
  },
  {
    q: 'Do I need to sign up or log in?',
    a: 'No. There is no signup, no login and no limit on how many calculators you can use.',
  },
  {
    q: 'Do you have calculators for India?',
    a: 'Yes. We offer EMI, home loan, SIP, FD, GST, HRA, salary (CTC to in-hand) and income tax calculators, including an old vs new tax regime comparison with state-wise professional tax.',
  },
  {
    q: 'Can I embed a calculator on my website?',
    a: 'Yes. Use our Embed a calculator page to add our calculators to your site for free. (Link "Embed a calculator" to the existing embed page.)',
  },
  {
    q: 'How do I request a new calculator?',
    a: 'Use the Request a calculator link below and tell us what you need. We add new calculators regularly based on what people ask for.',
  },
];

const trendingCalculators = [
  {
    slug: 'mortgage-calculator',
    name: 'Mortgage Calculator',
    description: 'Estimate your monthly mortgage payment, total interest and full amortization schedule.',
    icon: '🏠',
    href: '/finance/mortgage-calculator/',
  },
  {
    slug: 'loan-calculator',
    name: 'Loan Calculator',
    description: 'Work out monthly payments on a personal, auto or any other loan.',
    icon: '💵',
    href: '/finance/loan-calculator/',
  },
  {
    slug: 'emi-calculator',
    name: 'EMI Calculator',
    description: 'Calculate loan EMI for home, car or personal loans, with an interest and repayment breakdown.',
    icon: '🇮🇳',
    href: '/finance/emi-calculator/',
  },
  {
    slug: 'sip-calculator',
    name: 'SIP Calculator',
    description: 'Estimate mutual fund SIP returns and plan your investment goal.',
    icon: '📈',
    href: '/finance/sip-calculator/',
  },
  {
    slug: 'compound-interest-calculator',
    name: 'Compound Interest Calculator',
    description: 'See how savings and investments grow over time with compounding.',
    icon: '💹',
    href: '/finance/compound-interest-calculator/',
  },
  {
    slug: 'simple-interest-calculator',
    name: 'Simple Interest Calculator',
    description: 'Find interest on principal using SI = P × R × T.',
    icon: '🧾',
    href: '/finance/simple-interest-calculator/',
  },
  {
    slug: 'salary-calculator',
    name: 'Salary Calculator',
    description: 'Convert CTC to in-hand salary with EPF, professional tax and both tax regimes.',
    icon: '💼',
    href: '/finance/salary-calculator/',
  },
  {
    slug: 'income-tax-india',
    name: 'Income Tax Calculator India',
    description: 'Compare the old and new tax regime with HRA and state professional tax across all 16 states.',
    icon: '🪙',
    href: '/finance/income-tax-india/',
  },
  {
    slug: 'bmi-calculator',
    name: 'BMI Calculator',
    description: 'Check your body mass index using metric or imperial units.',
    icon: '⚖️',
    href: '/health/bmi-calculator/',
  },
  {
    slug: 'tdee-calculator',
    name: 'TDEE Calculator',
    description: 'Find out how many calories you burn each day based on your activity level.',
    icon: '🔥',
    href: '/health/tdee-calculator/',
  },
  {
    slug: 'pregnancy-calculator',
    name: 'Pregnancy Due Date Calculator',
    description: 'Estimate your due date and key pregnancy milestones.',
    icon: '🤰',
    href: '/health/pregnancy-calculator/',
  },
  {
    slug: 'calorie-calculator',
    name: 'Calorie Calculator',
    description: 'Get your daily calorie needs for weight loss, maintenance or weight gain.',
    icon: '🍎',
    href: '/health/calorie-calculator/',
  },
  {
    slug: 'percentage-calculator',
    name: 'Percentage Calculator',
    description: 'Find X% of Y, percentage change, increase and decrease in seconds.',
    icon: '％',
    href: '/math/percentage-calculator/',
  },
  {
    slug: 'cgpa-to-percentage-calculator',
    name: 'CGPA to Percentage Calculator',
    description: 'Convert CGPA to percentage and back for CBSE, VTU, Anna University and Mumbai University.',
    icon: '🎓',
    href: '/math/cgpa-to-percentage-calculator/',
  },
  {
    slug: 'fraction-calculator',
    name: 'Fraction Calculator',
    description: 'Add, subtract, multiply, divide and simplify fractions.',
    icon: '½',
    href: '/math/fraction-calculator/',
  },
  {
    slug: 'gpa-calculator',
    name: 'GPA Calculator',
    description: 'Calculate weighted GPA on the 4.0 scale from your courses and credit hours.',
    icon: '🎓',
    href: '/math/gpa-calculator/',
  },
  {
    slug: 'unit-converter',
    name: 'Unit Converter',
    description: 'Convert length, weight, volume, temperature and area units.',
    icon: '📏',
    href: '/conversions/unit-converter/',
  },
  {
    slug: 'currency-converter-hub',
    name: 'Currency Converter',
    description: 'Convert between 240+ currency pairs, with year-ago and 5-year rates.',
    icon: '💱',
    href: '/conversions/currency/',
  },
  {
    slug: 'time-zone-converter',
    name: 'Time Zone Converter',
    description: 'Convert times between EST, IST, GMT, PST and more, with daylight saving.',
    icon: '🌐',
    href: '/conversions/time-zone-converter/',
  },
  {
    slug: 'age-calculator',
    name: 'Age Calculator',
    description: 'Find your exact age in years, months, days, hours and minutes.',
    icon: '🎂',
    href: '/date-time/age-calculator/',
  },
  {
    slug: 'fuel-cost-calculator',
    name: 'Fuel Cost Calculator',
    description: 'Estimate trip fuel cost from distance, mileage and fuel price.',
    icon: '⛽',
    href: '/auto/fuel-cost-calculator/',
  },
];

const categories = [
  {
    key: 'finance',
    label: 'Finance Calculators',
    description: 'Mortgage, loan, EMI, SIP, tax, salary and investment calculators.',
    link: '/finance/',
    color: 'emerald',
    icon: '💰',
    calculators: [
      { name: 'Mortgage Calculator', href: '/finance/mortgage-calculator/' },
      { name: 'Home Loan EMI Calculator', href: '/finance/emi-calculator/' },
      { name: 'SIP Calculator', href: '/finance/sip-calculator/' },
      { name: 'Tax & GST Calculators', href: '/finance/' },
      { name: 'Investment Calculators', href: '/finance/' },
    ],
  },
  {
    key: 'health',
    label: 'Health Calculators',
    description: 'BMI, calorie, TDEE, body fat and pregnancy calculators.',
    link: '/health/',
    color: 'rose',
    icon: '❤️',
    calculators: [
      { name: 'BMI Calculator', href: '/health/bmi-calculator/' },
      { name: 'Calorie Calculator', href: '/health/calorie-calculator/' },
      { name: 'TDEE Calculator', href: '/health/tdee-calculator/' },
      { name: 'Body Fat Calculator', href: '/health/body-fat-calculator/' },
      { name: 'Pregnancy Calculator', href: '/health/pregnancy-calculator/' },
    ],
  },
  {
    key: 'math',
    label: 'Math Calculators',
    description: 'Percentage, fraction, discount, tip and grade calculators.',
    link: '/math/',
    color: 'violet',
    icon: '🧮',
    calculators: [
      { name: 'Percentage Calculator', href: '/math/percentage-calculator/' },
      { name: 'Fraction Calculator', href: '/math/fraction-calculator/' },
      { name: 'Discount Calculator', href: '/math/discount-calculator/' },
      { name: 'Tip Calculator', href: '/math/tip-calculator/' },
      { name: 'Grade Calculator', href: '/math/grade-calculator/' },
    ],
  },
  {
    key: 'conversion',
    label: 'Conversions',
    description: 'Unit, currency, temperature and time zone converters.',
    link: '/conversions/',
    color: 'amber',
    icon: '🔄',
    calculators: [
      { name: 'Unit Converter', href: '/conversions/unit-converter/' },
      { name: 'Currency Converter', href: '/conversions/currency/' },
      { name: 'Temperature Converter', href: '/conversions/temperature-converter/' },
      { name: 'Time Zone Converter', href: '/conversions/time-zone-converter/' },
    ],
  },
  {
    key: 'date-time',
    label: 'Date & Time Calculators',
    description: 'Age, date difference and countdown calculators.',
    link: '/date-time/',
    color: 'sky',
    icon: '📅',
    calculators: [
      { name: 'Age Calculator', href: '/date-time/age-calculator/' },
      { name: 'Date Difference', href: '/date-time/date-difference-calculator/' },
      { name: 'Countdown Timer', href: '/date-time/countdown-timer/' },
    ],
  },
  {
    key: 'construction',
    label: 'Construction Calculators',
    description: 'Concrete, paint, tile, brick and roofing material estimators.',
    link: '/construction/',
    color: 'orange',
    icon: '🔨',
    calculators: [
      { name: 'Concrete Calculator', href: '/construction/concrete-calculator/' },
      { name: 'Paint Calculator', href: '/construction/paint-calculator/' },
      { name: 'Tile Calculator', href: '/construction/tile-calculator/' },
      { name: 'Brick Calculator', href: '/construction/brick-calculator/' },
      { name: 'Roofing Calculator', href: '/construction/roofing-calculator/' },
    ],
  },
];

const websiteSchema = buildWebsiteSchema();
const organizationSchema = buildOrganizationSchema();
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq, index) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: trendingCalculators.map((calc, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: calc.name,
    url: `https://freecalculations.online${calc.href}`,
  })),
};
---

<BaseLayout
  title="Free Online Calculators – No Signup | FreeCalculations"
  description="70+ free online calculators for EMI, SIP, income tax, GST, mortgage, BMI and more. No signup, no limits, instant results right in your browser."
  canonical="/"
  schemas={[websiteSchema, organizationSchema, faqSchema, itemListSchema]}
  htmlLang="en"
  ogImage="/og-default.png"
>
  <!-- Announcement bar -->
  <div class="container-wide py-2.5 flex items-center justify-between gap-3 text-sm bg-amber-50 border border-amber-200 rounded-lg mx-4 my-4">
    <p class="!m-0 font-semibold truncate">Built for India too: EMI, SIP, GST and Income Tax calculators</p>
    <div class="flex items-center gap-2 flex-shrink-0">
      <a href="/finance/" class="px-3 py-1 rounded-full bg-amber-500 text-white font-extrabold text-xs no-underline hover:opacity-90" aria-label="Explore India calculators">Explore →</a>
      <button type="button" class="w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 font-bold text-amber-900" aria-label="Dismiss">✕</button>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-white">
    <div class="absolute inset-0 -z-10" aria-hidden="true" style="contain: layout style paint;">
      <div class="absolute top-[-10%] left-[-5%] w-[300px] h-[300px] md:w-[600px] md:h-[600px] bg-brand-400/40 rounded-full blur-[60px] md:blur-[120px] float-slow"></div>
      <div class="absolute top-[-5%] right-[-10%] w-[250px] h-[250px] md:w-[500px] md:h-[500px] bg-pink-accent/30 rounded-full blur-[60px] md:blur-[120px] float-slow-2"></div>
      <div class="hidden md:block absolute bottom-[-15%] left-[30%] w-[600px] h-[600px] bg-lime-accent/30 rounded-full blur-[140px] float-slow" style="animation-delay: -3s;"></div>
    </div>

    <div class="absolute inset-0 -z-10 bg-grain opacity-50" aria-hidden="true"></div>

    <div class="container-wide relative pt-10 pb-14 md:pt-16 md:pb-20 lg:pt-20 lg:pb-24">
      <div class="max-w-5xl mx-auto text-center">
        <div class="fade-in inline-flex items-center gap-2 chip-lime mb-7">
          <span class="text-base">✨</span>
          <span>{totalCount}+ FREE CALCULATORS · NO SIGNUP · UNLIMITED USE</span>
        </div>

        <h1 class="fade-in fade-in-delay-1 !text-5xl xs:!text-6xl sm:!text-7xl md:!text-8xl lg:!text-[9rem] !font-extrabold !tracking-tight !leading-[0.95] text-ink-900" style="font-family: 'Inter Tight', 'Inter', sans-serif;">
          Free Online Calculators
          <span class="bg-gradient-to-r from-brand-600 to-pink-accent bg-clip-text text-transparent">for every calculation.</span>
        </h1>

        <p class="fade-in fade-in-delay-2 mt-5 md:mt-7 text-base sm:text-lg md:text-xl text-ink-700 max-w-2xl mx-auto leading-relaxed font-medium">
          Calculate EMI, SIP returns, income tax, GST, mortgage payments, BMI, percentages and more with free online calculators that need no signup. Fast, accurate and unlimited, on any device.
        </p>

        <p class="text-lg font-bold text-brand-700 mt-4">No login. No limits. Always free.</p>

        <div class="fade-in fade-in-delay-3 mt-9 md:mt-12 relative z-30">
          <CalcSearch calculators={[]} client:load placeholder="Search {totalCount}+ free calculators…" aria-label="Search calculators" />
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-b from-transparent to-ink-900 -z-10" aria-hidden="true"></div>
  </section>

  <!-- Popular chips -->
  <section class="container-wide py-8 md:py-12">
    <h2 class="text-xs font-bold uppercase tracking-widest text-ink-400 mb-4 text-center">Most popular calculators</h2>
    <div class="flex flex-wrap justify-center gap-3 md:gap-4">
      {[
        { icon: '🏠', name: 'Mortgage', href: '/finance/mortgage-calculator/', 'aria-label': 'Mortgage Calculator' },
        { icon: '⚖️', name: 'BMI', href: '/health/bmi-calculator/', 'aria-label': 'BMI Calculator' },
        { icon: '🇮🇳', name: 'EMI', href: '/finance/emi-calculator/', 'aria-label': 'EMI Calculator' },
        { icon: '📈', name: 'SIP', href: '/finance/sip-calculator/', 'aria-label': 'SIP Calculator' },
        { icon: '💱', name: 'Currency', href: '/conversions/currency/', 'aria-label': 'Currency Converter' },
        { icon: '🪙', name: 'Income Tax', href: '/finance/income-tax-india/', 'aria-label': 'Income Tax Calculator India' },
      ].map((c) => (
        <a
          href={c.href}
          class="group inline-flex items-center gap-2 bg-white border-2 border-ink-900 rounded-full px-4 py-2.5 shadow-sticker-sm hover:shadow-sticker hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-150 no-underline"
          aria-label={`${c.name} Calculator`}
        >
          <span class="text-lg group-hover:scale-110 transition-transform">{c.icon}</span>
          <span class="font-extrabold text-ink-900 text-sm leading-tight">{c.name}</span>
        </a>
      ))}
    </div>
    <div class="text-center mt-6">
      <a href="#popular" class="text-sm font-semibold text-ink-500 hover:text-ink-900 underline decoration-2 underline-offset-4 decoration-ink-200 hover:decoration-ink-900 transition-all">See all {totalCount}+ calculators ↓</a>
    </div>
  </section>

  <!-- Marquee ticker -->
  <section class="bg-ink-900 text-white py-6 md:py-8 border-y-4 border-ink-900 overflow-hidden" aria-label="Featured calculators ticker">
    <div class="marquee">
      <div class="marquee-track gap-8 md:gap-12">
        {[...marqueeItems, ...marqueeItems].map((item, index) => (
          <span class="inline-flex items-center text-lg md:text-2xl font-extrabold tracking-tight whitespace-nowrap" aria-hidden={index >= marqueeItems.length} tabindex={index >= marqueeItems.length ? -1 : undefined}>
            {item}
            <span class="mx-8 md:mx-12 text-lime-accent">●</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Trending section -->
  <section id="popular" class="container-wide py-16 md:py-24 relative">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10 md:mb-14">
      <div>
        <span class="chip-yellow mb-4">🔥 Popular tools</span>
        <h2 class="!text-4xl sm:!text-5xl md:!text-6xl !mt-4 !mb-3 !leading-tight" style="font-family: 'Inter Tight', sans-serif;">
          Most-used free online calculators
        </h2>
        <p class="text-base md:text-lg text-ink-600 max-w-2xl">
          From loan EMI and SIP returns to BMI and percentages, these are the calculators people open most.
        </p>
      </div>
      <a
        href="#categories"
        class="hidden sm:inline-flex items-center gap-1 text-sm font-bold text-ink-900 hover:text-brand-700 no-underline whitespace-nowrap underline decoration-2 underline-offset-4 decoration-lime-accent hover:decoration-brand-500"
      >
        See all →
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
      {trendingCalculators.map((calc, idx) => {
        const bgClass = ['bg-lime-accent', 'bg-pink-accent text-white', 'bg-yellow-accent', 'bg-cyan-accent', 'bg-violet-300', 'bg-orange-300', 'bg-rose-300', 'bg-emerald-300'][idx % 8];
        return (
          <a href={calc.href} class={`group relative ${bgClass} border-2 border-ink-900 rounded-3xl p-5 sm:p-6 no-underline shadow-sticker hover:shadow-[8px_8px_0_0_rgba(15,23,42,0.9)] hover:-translate-x-1 hover:-translate-y-1 transition-all duration-200`}>
            <div class="text-4xl sm:text-5xl mb-3 sm:mb-4 inline-block transition-transform group-hover:scale-110 group-hover:rotate-6">
              {calc.icon}
            </div>
            <div class="font-extrabold text-ink-900 text-sm sm:text-base leading-tight" style="font-family: 'Inter Tight', sans-serif;">
              {calc.name}
            </div>
            <p class="text-xs sm:text-sm text-ink-800 mt-1.5 leading-snug line-clamp-2 font-medium">
              {calc.description}
            </p>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Use cases section -->
  <section class="relative bg-ink-50 border-y-2 border-ink-900 overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>

    <div class="container-wide relative py-16 md:py-24">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="chip-pink mb-4">💡 Use cases</span>
        <h2 class="!text-4xl sm:!text-5xl md:!text-6xl !mt-4 !leading-tight" style="font-family: 'Inter Tight', sans-serif;">
          Find the right calculator for what you're doing
        </h2>
        <p class="text-base md:text-lg text-ink-700 mt-4 font-medium">
          Pick your goal and we'll point you to the best free calculator for it.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
        {useCases.map((uc) => (
          <a
            href={uc.href}
            class="group relative bg-white border-2 border-ink-900 rounded-3xl p-6 md:p-7 flex flex-col shadow-sticker hover:shadow-[8px_8px_0_0_rgba(15,23,42,0.9)] hover:-translate-x-1 hover:-translate-y-1 transition-all duration-200 no-underline"
          >
            <span class={`${uc.chipColor} self-start mb-4`}>Now</span>
            <div class="text-5xl mb-4 transition-transform group-hover:rotate-12">{uc.icon}</div>
            <h3 class="!text-xl !mt-0 !mb-2 !text-ink-900 !leading-tight" style="font-family: 'Inter Tight', sans-serif;">
              {uc.title}
            </h3>
            <p class="text-sm text-ink-700 flex-1 leading-relaxed font-medium">{uc.desc}</p>
            <div class="mt-5 inline-flex items-center gap-1 text-sm font-extrabold text-ink-900 group-hover:gap-2 transition-all">
              {uc.cta}
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section class="relative bg-white border-b-2 border-ink-900 overflow-hidden">
    <div class="container-wide py-16 md:py-20">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        <div class="stat-block">
          <span class="stat-num text-gradient-electric">{totalCount}+</span>
          <div class="stat-label">Free calculators</div>
        </div>
        <div class="stat-block">
          <span class="stat-num text-gradient-sunset">100%</span>
          <div class="stat-label">Free to use</div>
        </div>
        <div class="stat-block">
