---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildBreadcrumbSchema, buildFAQSchema } from '../../lib/seo';

const path = '/guides/emergency-fund-how-much';
const lastUpdated = '2026-07-24';
const breadcrumbs = [
  { name: 'Home', url: '/' }, { name: 'Guides', url: '/guides/' }, { name: 'How Big an Emergency Fund', url: path },
];

// Build-time: emergency fund = essential monthly expenses x months of cover.
// Worked example uses ₹50,000 of essential monthly expenses.
const EXAMPLE = 50000;
const LO_MONTHS = 3, HI_MONTHS = 6;
const exLow = EXAMPLE * LO_MONTHS;
const exHigh = EXAMPLE * HI_MONTHS;

// Table: target fund across essential-expense levels, at 3 and 6 months.
const levels = [20000, 30000, 50000, 75000, 100000, 150000].map((m) => ({
  monthly: m,
  low: m * LO_MONTHS,
  high: m * HI_MONTHS,
}));

// Where to hold it: keep ~1 month instantly liquid in a savings account,
// park the rest in a liquid fund / sweep FD. Interest is a bonus, not the point.
const SAV_RATE = 3.0, LIQ_RATE = 6.5, INFLATION = 6.0;
const savingsPart = EXAMPLE * 1;              // 1 month, instant access
const liquidPart = exHigh - savingsPart;      // remaining 5 months
const allInSavings = exHigh * SAV_RATE / 100;
const splitYield = savingsPart * SAV_RATE / 100 + liquidPart * LIQ_RATE / 100;
const yieldGain = splitYield - allInSavings;
const inflationDrag = exHigh * INFLATION / 100;

const fmtINR = (v: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(v);

const faqs = [
  { q: 'How many months of expenses should an emergency fund cover?', a: `The standard range is ${LO_MONTHS} to ${HI_MONTHS} months of essential expenses. Where you land depends on how stable your income is. A salaried person in a dual-income household with an easily re-hireable skill can sit near ${LO_MONTHS} months. Aim for ${HI_MONTHS} months (or more) if you are the sole earner, self-employed, on commission, in a niche role that takes months to re-hire, or supporting dependants. On ${fmtINR(EXAMPLE)} of monthly essentials that is a target between ${fmtINR(exLow)} and ${fmtINR(exHigh)}.` },
  { q: 'Should I count my full salary or just essential expenses?', a: 'Only essentials, never your full salary or full spending. An emergency fund exists to keep the lights on if income stops, so size it to what you genuinely cannot skip: rent or home-loan EMI, other loan EMIs, groceries, utilities, school fees, insurance premiums, and basic transport. Leave out dining out, subscriptions, holidays and shopping, because in a real crunch those pause anyway. Padding the target with discretionary spending just locks up money that could be working elsewhere.' },
  { q: 'Where should I keep my emergency fund?', a: `Split it for access and a little yield. Keep roughly one month (${fmtINR(savingsPart)} in this example) in a plain savings account so it is available the same day, and park the rest (${fmtINR(liquidPart)}) in a liquid fund or a sweep-in FD that redeems in a day or two. Never put emergency money in equity (it can be down 30% exactly when you need it) or in a long locked FD with a break penalty. The goal is certainty and speed, not return.` },
  { q: 'Should I build my emergency fund before investing or paying off debt?', a: 'Build a small buffer first, then attack high-interest debt, then finish the fund. A credit-card balance at 36 to 42% APR costs far more than any fund earns, so clear that before topping up to six months. But do keep a starter cushion (even one month) while you pay down debt, otherwise the next surprise expense goes straight back onto the card. Only long-horizon equity investing should wait behind a full emergency fund; a market dip plus a job loss at the same time is exactly the trap the fund prevents.' },
  { q: 'Will my emergency fund lose value to inflation sitting idle?', a: `A little, and that is fine, it is insurance, not an investment. At ${INFLATION}% inflation, ${fmtINR(exHigh)} loses about ${fmtINR(inflationDrag)} of purchasing power a year. But the liquid-fund portion earning ~${LIQ_RATE}% roughly offsets that, so the real erosion is small. Trying to squeeze extra return by moving the fund into equity or locked instruments defeats its purpose: the whole value of an emergency fund is that it is boring, safe and there the day you need it.` },
];
const schemas = [buildBreadcrumbSchema(breadcrumbs), buildFAQSchema(faqs)];
---

<BaseLayout title={`How Big Should Your Emergency Fund Be? (2026): ₹50k Expenses = ${fmtINR(exHigh)}`} description={`An emergency fund is ${LO_MONTHS} to ${HI_MONTHS} months of essential expenses. At ${fmtINR(EXAMPLE)}/month that is ${fmtINR(exLow)} to ${fmtINR(exHigh)}. Full target table by expense level, plus where to hold it (savings + liquid fund). Every figure computed.`} schemas={schemas} publishedTime={lastUpdated} modifiedTime={lastUpdated}>
  <section class="relative overflow-hidden bg-white">
    <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
      <div class="absolute top-[-10%] left-[-5%] w-[500px] h-[500px] bg-cyan-accent/30 rounded-full blur-[120px] float-slow"></div>
      <div class="absolute top-[5%] right-[-10%] w-[400px] h-[400px] bg-lime-accent/25 rounded-full blur-[120px] float-slow-2"></div>
    </div>
    <div class="container-wide relative pt-8 pb-10 md:pt-12 md:pb-14">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm">
          {breadcrumbs.map((item, idx) => (
            <li class="flex items-center gap-1.5">
              {idx === breadcrumbs.length - 1 ? (
                <span class="px-3 py-1 rounded-full bg-ink-900 text-white font-bold border-2 border-ink-900">{item.name}</span>
              ) : (
                <>
                  <a href={item.url} class="px-3 py-1 rounded-full bg-white border-2 border-ink-200 text-ink-700 font-semibold hover:border-ink-900 hover:text-ink-900 no-underline transition-colors">{item.name}</a>
                  <svg class="w-3 h-3 text-ink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </>
              )}
            </li>
          ))}
        </ol>
      </nav>
      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-2 mb-5">
          <span class="chip-cyan">📚 Guide</span>
          <span class="chip-lime">🛟 Safety net</span>
          <span class="chip-white"><span class="text-ink-500">Updated</span><span>{lastUpdated}</span></span>
        </div>
        <h1 class="!text-4xl sm:!text-5xl md:!text-6xl !font-extrabold !tracking-tight !leading-[1.05] text-ink-900" style="font-family: 'Inter Tight', sans-serif; letter-spacing: -0.035em;">
          How big should your <span class="text-gradient-brand">emergency fund</span> be?
        </h1>
        <div class="mt-7 bg-yellow-accent border-[2.5px] border-ink-900 rounded-2xl p-5 shadow-sticker">
          <div class="flex items-start gap-3">
            <div class="text-2xl">⚡</div>
            <div>
              <div class="text-xs font-extrabold uppercase tracking-wider text-ink-900 mb-1">Quick answer</div>
              <p class="text-ink-900 text-base sm:text-lg leading-relaxed font-medium !m-0">
                <strong>{LO_MONTHS} to {HI_MONTHS} months of essential expenses</strong>, not your salary. If your must-pay costs are {fmtINR(EXAMPLE)}/month, target <strong>{fmtINR(exLow)}</strong> (stable job) up to <strong>{fmtINR(exHigh)}</strong> (single or variable income). Keep about a month in savings for instant access and the rest in a liquid fund. It is insurance, so size it for safety, not return.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide pb-12 md:pb-16 pt-4">
    <div class="max-w-4xl mx-auto prose prose-lg">
      <h2 style="font-family: 'Inter Tight', sans-serif;">Your target, by monthly expenses</h2>
      <p class="text-ink-700 font-medium leading-relaxed max-w-3xl">
        An emergency fund is not a round number you pick out of the air, it is a multiple of what you actually spend to live. The rule of thumb is {LO_MONTHS} to {HI_MONTHS} months of <em>essential</em> expenses: rent or EMI, groceries, utilities, insurance, school fees, basic transport. Not holidays, not dining out. Add those must-pay items up, then read your target off the table below. The {LO_MONTHS}-month column suits a stable salaried earner in a two-income home; the {HI_MONTHS}-month column is for a sole earner, freelancer, or anyone whose income can pause.
      </p>
      <div class="not-prose overflow-x-auto">
        <table class="w-full bg-white border-[2.5px] border-ink-900 rounded-2xl shadow-sticker-sm overflow-hidden border-separate border-spacing-0 text-sm">
          <thead><tr class="bg-ink-900 text-white">
            <th class="text-left p-3 font-extrabold">Essential expenses / month</th>
            <th class="text-right p-3 font-extrabold">{LO_MONTHS}-month fund</th>
            <th class="text-right p-3 font-extrabold">{HI_MONTHS}-month fund</th>
          </tr></thead>
          <tbody>
            {levels.map((r, i) => (
              <tr class={`border-b-2 border-ink-100 ${r.monthly === EXAMPLE ? 'bg-yellow-accent/40' : i % 2 ? 'bg-ink-50' : 'bg-lime-accent/15'}`}>
                <td class="p-3 font-bold text-ink-900">{fmtINR(r.monthly)}{r.monthly === EXAMPLE ? ' ← example' : ''}</td>
                <td class="p-3 text-right font-mono font-extrabold text-ink-900">{fmtINR(r.low)}</td>
                <td class="p-3 text-right font-mono font-bold text-ink-900">{fmtINR(r.high)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-ink-500 mt-3 font-medium">Fund = essential monthly expenses x months of cover. Use essentials only, not full income. Not investment advice.</p>

      <h2 style="font-family: 'Inter Tight', sans-serif;">Where to hold it (and the small yield you still get)</h2>
      <p class="text-ink-700 font-medium leading-relaxed max-w-3xl">
        The two jobs of an emergency fund are pulling in opposite directions: you want it available the instant a crisis hits, but you also do not want {fmtINR(exHigh)} earning a lazy {SAV_RATE}% forever. The fix is to split it. Keep roughly one month ({fmtINR(savingsPart)}) in a plain savings account for same-day access, and park the other five months ({fmtINR(liquidPart)}) in a liquid fund or sweep-in FD that redeems in a day or two. That split earns about {fmtINR(splitYield)} a year versus {fmtINR(allInSavings)} if it all sat in savings, roughly {fmtINR(yieldGain)} more, while still being reachable within 24 to 48 hours. Just remember the point is access, not the yield: never chase returns here by moving the fund into equity or a locked deposit. For a fuller comparison of parking spots, see our guide on <a href="/guides/fd-vs-debt-fund-vs-savings/">where to park your money</a>.
      </p>
    </div>
  </section>

  <section class="bg-ink-50 border-y-2 border-ink-900">
    <div class="container-wide py-12 md:py-16">
      <div class="max-w-3xl mx-auto">
        <span class="chip-yellow mb-4">❓ FAQ</span>
        <h2 class="!text-3xl sm:!text-4xl !mt-4 !leading-tight" style="font-family: 'Inter Tight', sans-serif;">Common questions.</h2>
        <div class="space-y-3 mt-8">
          {faqs.map((faq, idx) => (
            <details class="group bg-white border-2 border-ink-900 rounded-2xl shadow-sticker-sm hover:shadow-sticker transition-all" open={idx === 0}>
              <summary class="cursor-pointer p-5 md:p-6 font-extrabold text-ink-900 flex items-center justify-between gap-4 list-none">
                <span class="text-base md:text-lg" style="font-family: 'Inter Tight', sans-serif;">{faq.q}</span>
                <span class="flex-shrink-0 w-9 h-9 rounded-full bg-ink-900 group-open:bg-lime-accent flex items-center justify-center transition-colors">
                  <svg class="w-4 h-4 text-white group-open:text-ink-900 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </span>
              </summary>
              <div class="px-5 md:px-6 pb-5 md:pb-6 text-ink-700 leading-relaxed font-medium">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide py-12 md:py-16">
    <div class="max-w-3xl mx-auto">
      <span class="chip bg-violet-300 text-ink-900 mb-4">🔗 Related</span>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
        {[
          { name: 'Where to Park Money', href: '/guides/fd-vs-debt-fund-vs-savings/', icon: '💰', color: 'bg-cyan-accent' },
          { name: 'Budget Calculator', href: '/finance/budget-calculator/', icon: '🧮', color: 'bg-lime-accent' },
          { name: 'FD Calculator', href: '/finance/fd-calculator/', icon: '🏦', color: 'bg-yellow-accent' },
        ].map((c) => (
          <a href={c.href} class={`group ${c.color} border-[2.5px] border-ink-900 rounded-3xl p-5 no-underline shadow-sticker hover:shadow-[8px_8px_0_0_rgba(15,23,42,0.9)] hover:-translate-x-1 hover:-translate-y-1 transition-all duration-200`}>
            <div class="text-3xl mb-2 group-hover:rotate-12 transition-transform inline-block">{c.icon}</div>
            <div class="font-extrabold text-ink-900 text-base leading-tight" style="font-family: 'Inter Tight', sans-serif;">{c.name}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
