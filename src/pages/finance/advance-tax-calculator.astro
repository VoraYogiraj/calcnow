---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdvanceTaxCalculator from '../../components/calculators/AdvanceTaxCalculator.tsx';
import {
  buildCalculatorSchema, buildBreadcrumbSchema, buildFAQSchema,
  buildSpeakableSchema, buildHowToSchema,
} from '../../lib/seo';

const path = '/finance/advance-tax-calculator';

const meta = {
  slug: 'advance-tax-calculator',
  name: 'Advance Tax Calculator',
  description: 'Free advance tax calculator India FY 2025-26. Estimate your annual income tax, subtract TDS, check the ₹10,000 threshold, and split the balance into the 4 statutory installments (15/45/75/100%) with due dates.',
  category: 'finance' as const,
  keywords: ['advance tax calculator', 'advance tax calculator india', 'advance tax installments', 'advance tax due dates', 'section 234b 234c', 'advance tax fy 2025-26'],
  lastUpdated: '2026-08-26',
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Finance', url: '/finance/' },
  { name: 'Advance Tax Calculator', url: path },
];

// Static schedule shown on the page for the default ₹15L new-regime example.
// Tax = ₹97,500 (₹93,750 + 4% cess ₹3,750), computed with the same new-regime
// slabs as the India Income Tax Calculator so the two calculators agree.
const exampleSchedule = [
  { date: 'On or before 15 Jun 2025', cumPct: '15%', cumAmt: '₹14,625', inst: '₹14,625 (15%)' },
  { date: 'On or before 15 Sep 2025', cumPct: '45%', cumAmt: '₹43,875', inst: '₹29,250 (30%)' },
  { date: 'On or before 15 Dec 2025', cumPct: '75%', cumAmt: '₹73,125', inst: '₹29,250 (30%)' },
  { date: 'On or before 15 Mar 2026', cumPct: '100%', cumAmt: '₹97,500', inst: '₹24,375 (25%)' },
];

const faqs = [
  {
    q: 'Who must pay advance tax in FY 2025-26?',
    a: 'Any taxpayer whose total income tax liability for the year, after subtracting TDS already deducted, is ₹10,000 or more must pay advance tax under Section 208. This is not limited to businesses. It includes salaried employees who earn extra income (interest, capital gains, rent, dividends, freelance fees) on which enough tax is not already withheld, plus freelancers, professionals, consultants, traders and companies. Resident senior citizens (aged 60+) with no income from business or profession are exempt from advance tax. If your net liability stays below ₹10,000, you can simply pay it as self-assessment tax when you file.',
  },
  {
    q: 'What are the advance tax due dates and cumulative percentages?',
    a: 'For non-presumptive taxpayers, FY 2025-26 advance tax is paid in four installments with cumulative targets: by 15 June 2025 pay 15% of total advance tax; by 15 September 2025 reach 45% cumulative; by 15 December 2025 reach 75% cumulative; and by 15 March 2026 reach 100%. In incremental terms that is 15%, then 30%, then 30%, then a final 25%. If a due date falls on a Sunday or bank holiday, payment on the next working day is generally accepted. Missing or underpaying a target triggers interest under Section 234C on the shortfall.',
  },
  {
    q: 'How does the presumptive scheme (44AD / 44ADA) change advance tax?',
    a: 'Taxpayers who opt for the presumptive taxation scheme get a simplified single-installment rule. Small businesses under Section 44AD and professionals such as doctors, lawyers, architects and consultants under Section 44ADA are not required to pay the four quarterly installments. Instead, they pay 100% of their advance tax liability in one installment by 15 March 2026. Any shortfall after that date is treated as self-assessment tax. This concession only covers those actually declaring income on a presumptive basis; if you keep regular books and are assessed normally, the standard 15/45/75/100% four-installment schedule applies.',
  },
  {
    q: 'What is interest under Section 234B and Section 234C?',
    a: 'These are two separate interest charges for advance tax defaults, each at 1% per month simple interest. Section 234B applies when you pay less than 90% of your assessed tax as advance tax by 31 March; interest runs from 1 April until the tax is paid. Section 234C applies when individual installments fall short of their cumulative targets (15%, 45%, 75%, 100%); it is charged for the period of deferment on each shortfall, generally three months per installment and one month for the final one. Paying each installment on time and in full avoids both. This calculator flags the shortfall but does not compute the interest itself.',
  },
  {
    q: 'How does TDS reduce the advance tax I owe?',
    a: 'Advance tax is only payable on the tax that is not already collected through TDS (tax deducted at source). You first estimate your total tax for the year including the 4% Health and Education Cess, then subtract the TDS your employer, bank or other payers have deducted or will deduct. The remaining balance is your advance tax, and the ₹10,000 threshold is tested on that net figure. Salaried employees whose employers deduct enough TDS on salary often owe no advance tax on that salary, but must still pay advance tax on side income (interest, capital gains, rent) where TDS is nil or too low.',
  },
];

const schemas = [
  buildCalculatorSchema(meta, path),
  buildBreadcrumbSchema(breadcrumbs),
  buildFAQSchema(faqs),
  buildSpeakableSchema(path),
  buildHowToSchema({
    name: 'How to calculate advance tax in India',
    description: 'Step-by-step instructions to estimate advance tax for FY 2025-26 and split it into the four statutory installments.',
    totalTime: 'PT1M', estimatedCost: { value: '0', currency: 'INR' },
    steps: [
      { name: 'Estimate your annual income', text: 'Enter your estimated total income for the year. Under the new regime a ₹75,000 standard deduction is applied automatically; under the old regime add your 80C, HRA and NPS deductions.' },
      { name: 'Compute total tax with cess', text: 'The calculator applies the FY 2025-26 slabs, the Section 87A rebate, and the 4% Health and Education Cess to give your estimated total tax liability.' },
      { name: 'Subtract TDS and test the threshold', text: 'Enter TDS already deducted or expected. Advance tax equals total tax minus TDS. If that balance is ₹10,000 or more, advance tax is due.' },
      { name: 'Read the installment schedule', text: 'The 4-installment table shows the cumulative 15/45/75/100% due by 15 Jun, 15 Sep, 15 Dec and 15 Mar, plus the incremental amount for each date.' },
    ],
  }),
];

const relatedCalcs = [
  { name: 'Income Tax India', href: '/finance/income-tax-india/', desc: 'Old vs new regime, FY 2025-26.', icon: '🇮🇳', color: 'bg-yellow-accent' },
  { name: 'TDS Calculator', href: '/finance/tds-calculator/', desc: 'Tax deducted at source by section.', icon: '✂️', color: 'bg-cyan-accent' },
  { name: 'Salary Calculator', href: '/finance/salary-calculator/', desc: 'CTC to in-hand take-home.', icon: '💼', color: 'bg-lime-accent' },
  { name: 'Capital Gains', href: '/finance/capital-gains-calculator/', desc: 'STCG & LTCG on assets.', icon: '📈', color: 'bg-white' },
  { name: 'HRA Calculator', href: '/finance/hra-calculator/', desc: 'House Rent Allowance exemption.', icon: '🏠', color: 'bg-violet-300' },
];
---

<BaseLayout
  title="Advance Tax Calculator India 🗓️"
  description={meta.description}
  schemas={schemas}
  publishedTime={meta.lastUpdated}
  modifiedTime={meta.lastUpdated}
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-white">
    <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
      <div class="absolute top-[-10%] left-[-5%] w-[500px] h-[500px] bg-yellow-accent/30 rounded-full blur-[120px] float-slow"></div>
      <div class="absolute top-[5%] right-[-10%] w-[400px] h-[400px] bg-cyan-accent/25 rounded-full blur-[120px] float-slow-2"></div>
    </div>
    <div class="container-wide relative pt-8 pb-10 md:pt-12 md:pb-14">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm">
          {breadcrumbs.map((item, idx) => (
            <li class="flex items-center gap-1.5">
              {idx === breadcrumbs.length - 1 ? (
                <span class="px-3 py-1 rounded-full bg-ink-900 text-white font-bold border-2 border-ink-900">{item.name}</span>
              ) : (
                <>
                  <a href={item.url} class="px-3 py-1 rounded-full bg-white border-2 border-ink-200 text-ink-700 font-semibold hover:border-ink-900 hover:text-ink-900 no-underline transition-colors">{item.name}</a>
                  <svg class="w-3 h-3 text-ink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </>
              )}
            </li>
          ))}
        </ol>
      </nav>

      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-2 mb-5">
          <span class="chip-yellow">🗓️ Advance tax</span>
          <span class="chip-cyan">FY 2025-26</span>
          <span class="chip-white"><span class="text-ink-500">Last updated</span><span>{meta.lastUpdated}</span></span>
        </div>
        <h1 class="!text-4xl sm:!text-5xl md:!text-6xl !font-extrabold !tracking-tight !leading-[1.05] text-ink-900" style="font-family: 'Inter Tight', sans-serif; letter-spacing: -0.035em;">
          Advance Tax Calculator.
          <span class="text-gradient-brand">Pay as you earn.</span>
        </h1>
        <div class="speakable-answer mt-7 bg-yellow-accent border-[2.5px] border-ink-900 rounded-2xl p-5 shadow-sticker">
          <div class="flex items-start gap-3">
            <div class="text-2xl">⚡</div>
            <div>
              <div class="text-xs font-extrabold uppercase tracking-wider text-ink-900 mb-1">Quick answer</div>
              <p class="text-ink-900 text-base sm:text-lg leading-relaxed font-medium !m-0">
                On an estimated <strong>₹15,00,000</strong> income (new regime, FY 2025-26, no TDS), tax is <strong>₹97,500</strong> (₹93,750 + 4% cess ₹3,750). Since this is above the ₹10,000 threshold, pay advance tax in 4 installments: <strong>₹14,625</strong> by 15 Jun, <strong>₹29,250</strong> by 15 Sep, <strong>₹29,250</strong> by 15 Dec, and <strong>₹24,375</strong> by 15 Mar (cumulative 15% / 45% / 75% / 100%).
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="container-wide pb-12 md:pb-16">
    <div class="max-w-4xl mx-auto">
      <AdvanceTaxCalculator client:visible />
    </div>
  </section>

  <!-- HOW TO USE -->
  <section class="container-wide pb-12 md:pb-16">
    <div class="max-w-4xl mx-auto">
      <span class="chip-cyan mb-4">📖 How to use</span>
      <h2 class="!text-3xl sm:!text-4xl !mt-4 !leading-tight" style="font-family: 'Inter Tight', sans-serif;">4 inputs. Instant schedule.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5 mt-8">
        {[
          { num: '1', text: 'Estimate your annual income. New regime applies the ₹75,000 standard deduction automatically.', color: 'bg-yellow-accent' },
          { num: '2', text: 'Add old-regime deductions (80C, HRA, NPS) if you toggle to the old regime.', color: 'bg-pink-accent text-white' },
          { num: '3', text: 'Enter TDS already deducted or expected. Advance tax = total tax minus TDS.', color: 'bg-cyan-accent' },
          { num: '4', text: 'Read the 4-installment table with due dates, cumulative % and this-installment amounts.', color: 'bg-lime-accent' },
        ].map((step) => (
          <div class={`${step.color} border-[2.5px] border-ink-900 rounded-2xl p-5 shadow-sticker-sm`}>
            <div class="text-3xl font-extrabold mb-3 leading-none" style="font-family: 'Inter Tight', sans-serif;">{step.num}</div>
            <p class="text-sm font-semibold leading-snug !m-0 !text-current">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INSTALLMENT SCHEDULE (worked example) -->
  <section class="bg-ink-900 text-white">
    <div class="container-wide py-12 md:py-16">
      <div class="max-w-4xl mx-auto">
        <span class="chip bg-lime-accent text-ink-900 mb-4">🗓️ Installment schedule</span>
        <h2 class="!text-3xl sm:!text-4xl !mt-4 !leading-tight !text-white" style="font-family: 'Inter Tight', sans-serif;">The 4 statutory installments.</h2>
        <p class="text-ink-300 mt-3 text-lg font-medium max-w-2xl">
          Worked example for a ₹15,00,000 income (new regime, no TDS): total tax ₹97,500. Non-presumptive taxpayers pay on the cumulative schedule below.
        </p>
        <div class="mt-8 overflow-x-auto rounded-2xl border border-white/10">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-ink-400 border-b border-white/10">
                <th class="text-left px-4 py-3 font-semibold">Due date</th>
                <th class="text-right px-4 py-3 font-semibold">Cumulative %</th>
                <th class="text-right px-4 py-3 font-semibold">Cumulative due</th>
                <th class="text-right px-4 py-3 font-semibold">This installment</th>
              </tr>
            </thead>
            <tbody class="text-ink-200 divide-y divide-white/5">
              {exampleSchedule.map((r) => (
                <tr>
                  <td class="px-4 py-3 font-semibold text-white">{r.date}</td>
                  <td class="px-4 py-3 text-right">{r.cumPct}</td>
                  <td class="px-4 py-3 text-right">{r.cumAmt}</td>
                  <td class="px-4 py-3 text-right font-bold text-lime-accent">{r.inst}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-ink-400 mt-4">
          Presumptive taxpayers under Sections 44AD / 44ADA pay 100% (₹97,500 in this example) in a single installment by 15 Mar 2026. Shortfalls attract interest under Sections 234B and 234C at 1% per month. Verify current slabs and due dates on incometax.gov.in.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-ink-50 border-y-2 border-ink-900">
    <div class="container-wide py-12 md:py-16">
      <div class="max-w-3xl mx-auto">
        <span class="chip-yellow mb-4">❓ FAQ</span>
        <h2 class="!text-3xl sm:!text-4xl !mt-4 !leading-tight" style="font-family: 'Inter Tight', sans-serif;">Advance tax FAQ.</h2>
        <div class="space-y-3 mt-8">
          {faqs.map((faq, idx) => (
            <details class="group bg-white border-2 border-ink-900 rounded-2xl shadow-sticker-sm hover:shadow-sticker transition-all" open={idx === 0}>
              <summary class="cursor-pointer p-5 md:p-6 font-extrabold text-ink-900 flex items-center justify-between gap-4 list-none">
                <span class="text-base md:text-lg" style="font-family: 'Inter Tight', sans-serif;">{faq.q}</span>
                <span class="flex-shrink-0 w-9 h-9 rounded-full bg-ink-900 group-open:bg-lime-accent flex items-center justify-center transition-colors">
                  <svg class="w-4 h-4 text-white group-open:text-ink-900 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </span>
              </summary>
              <div class="px-5 md:px-6 pb-5 md:pb-6 text-ink-700 leading-relaxed font-medium">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="container-wide py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <span class="chip bg-violet-300 text-ink-900 mb-4">🔗 Related India calculators</span>
      <h2 class="!text-3xl sm:!text-4xl !mt-4 !leading-tight" style="font-family: 'Inter Tight', sans-serif;">Try these next.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mt-8">
        {relatedCalcs.map((c) => (
          <a href={c.href} class={`group ${c.color} border-[2.5px] border-ink-900 rounded-3xl p-5 no-underline shadow-sticker hover:shadow-[8px_8px_0_0_rgba(15,23,42,0.9)] hover:-translate-x-1 hover:-translate-y-1 transition-all duration-200`}>
            <div class="text-3xl mb-3 group-hover:rotate-12 transition-transform inline-block">{c.icon}</div>
            <div class="font-extrabold text-ink-900 text-base leading-tight" style="font-family: 'Inter Tight', sans-serif;">{c.name}</div>
            <p class="text-xs text-ink-800 mt-1.5 leading-snug font-medium">{c.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
