---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StepUpSipCalculator from '../../components/calculators/StepUpSipCalculator.tsx';
import {
  buildCalculatorSchema,
  buildBreadcrumbSchema,
  buildFAQSchema,
  buildSpeakableSchema,
  buildHowToSchema,
} from '../../lib/seo';

const path = '/finance/step-up-sip-calculator';

const meta = {
  slug: 'step-up-sip-calculator',
  name: 'Step-Up SIP Calculator',
  description: 'Free step-up (top-up) SIP calculator for Indian mutual fund investors. See maturity value, total invested, and exactly how much more a rising SIP earns versus a flat SIP. Live recalculation, no signup.',
  category: 'finance' as const,
  keywords: ['step up sip calculator', 'top up sip calculator', 'step up sip vs flat sip', 'annual step up sip', 'sip step up calculator'],
  lastUpdated: '2026-08-26',
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Finance', url: '/finance/' },
  { name: 'Step-Up SIP Calculator', url: path },
];

const faqs = [
  {
    q: 'What is a step-up (top-up) SIP and why does it beat a flat SIP?',
    a: 'A step-up SIP, also called a top-up SIP, raises your monthly contribution by a fixed percentage every year instead of holding it flat for the entire tenure. The logic mirrors real life: your salary rises over time, so your investing should keep pace rather than staying frozen at whatever you could afford on day one. A flat SIP quietly shrinks as a share of your income and loses ground to inflation. Stepping the amount up each year keeps your saving rate roughly constant against your take-home pay, and because more money goes in during the early and middle years, the final corpus ends up materially larger than a flat plan that started at the same figure.',
  },
  {
    q: 'How does the annual step-up compound over time?',
    a: 'Two engines work together in a step-up SIP. First, each instalment earns compound returns for however many months remain until maturity, exactly like an ordinary SIP. Second, the contribution itself grows geometrically: a 10% annual step-up multiplies your monthly amount by 1.10 every year, so ₹10,000 becomes ₹11,000, then ₹12,100, and so on. The powerful part is that the raises you make in the early years get the longest runway to compound. That is why the gap between a step-up and a flat SIP widens faster than the extra rupees you contribute, because the early increases spend the most time in the market working for you.',
  },
  {
    q: 'What is a realistic annual step-up percentage?',
    a: 'For most salaried investors, 5% to 10% a year is the realistic band, because it roughly tracks typical annual salary hikes and inflation. Set the step-up close to your expected raise and each year’s higher SIP stays about the same slice of your take-home pay, so it never feels like a squeeze. A 10% step-up suits steady corporate increments; 5% is safer if your income growth is modest or uneven. Very high step-ups like 15% or 20% build bigger corpuses on paper, but only if you can genuinely sustain the rising outflow for the full tenure. Pick a rate you can commit to and actually keep, since a step-up only works if you follow through.',
  },
  {
    q: 'Should I step up by a fixed percentage or a fixed rupee amount?',
    a: 'Both work; they suit different people. A fixed percentage step-up (say 10% a year) scales with your growing base, so the rupee increase gets larger over time and the SIP keeps pace with a compounding salary. A fixed rupee step-up (for example ₹1,000 more each year) is simpler to picture and budget, but as a share of a rising income it shrinks, so its effect fades in later years. Percentage step-ups generally build a larger corpus over long horizons because the increases themselves compound. If you value predictability, a fixed rupee top-up is fine; if you are optimising the final number, the percentage approach usually wins. This calculator uses a fixed annual percentage.',
  },
  {
    q: 'Is a step-up SIP good for long-term goals?',
    a: 'Step-up SIPs shine on long-horizon goals like retirement, a child’s higher education, or a home down payment, where there is enough time for the early raises to compound hard. Over 20 to 30 years, a modest annual step-up can lift the final corpus well beyond a flat SIP without ever demanding an unaffordable amount in any single year, because the increases arrive alongside your rising income. For short goals of three to five years, the benefit is smaller and market risk matters more, so favour lower-volatility funds. Whatever the horizon, pre-commit the step-up so it happens automatically, and remember that mutual fund returns are not guaranteed and can vary year to year.',
  },
];

const schemas = [
  buildCalculatorSchema(meta, path),
  buildBreadcrumbSchema(breadcrumbs),
  buildFAQSchema(faqs),
  buildSpeakableSchema(path),
  buildHowToSchema({
    name: 'How to calculate step-up SIP maturity value',
    description: 'Step-by-step instructions for estimating a step-up (top-up) SIP maturity value, and comparing it against a flat SIP that starts at the same monthly amount.',
    totalTime: 'PT2M',
    estimatedCost: { value: '0', currency: 'INR' },
    steps: [
      { name: 'Enter your starting monthly SIP', text: 'Type the amount you can comfortably invest each month right now. This is the year-one figure that will be raised every year after.' },
      { name: 'Set the annual step-up percentage', text: 'Match it to your expected salary growth, typically 5 to 10 percent a year, so the SIP stays about the same share of your income.' },
      { name: 'Add expected return and tenure', text: 'Use a realistic long-term return of 10 to 12 percent for diversified equity funds, then pick how many years you will keep investing.' },
      { name: 'Read the maturity and the flat-SIP comparison', text: 'See the maturity value, total invested, and wealth gained, plus how much extra corpus the step-up adds over a flat SIP that starts at the same amount.' },
    ],
  }),
];

const relatedCalculators = [
  { label: 'SIP calculator', href: '/finance/sip-calculator/' },
  { label: 'Lumpsum', href: '/finance/lumpsum-calculator/' },
  { label: 'SWP', href: '/finance/swp-calculator/' },
  { label: 'CAGR', href: '/finance/cagr-calculator/' },
  { label: 'Step-Up vs Flat SIP guide', href: '/guides/sip-step-up-vs-flat/' },
];
---

<BaseLayout
  title="Step-Up SIP Calculator 📈"
  description={meta.description}
  schemas={schemas}
  publishedTime={meta.lastUpdated}
  modifiedTime={meta.lastUpdated}
>
  <section class="relative overflow-hidden bg-white">
    <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
      <div class="absolute top-[-10%] left-[-5%] w-[500px] h-[500px] bg-lime-accent/30 rounded-full blur-[120px] float-slow"></div>
      <div class="absolute top-[5%] right-[-10%] w-[400px] h-[400px] bg-cyan-accent/25 rounded-full blur-[120px] float-slow-2"></div>
    </div>

    <div class="container-wide relative pt-8 pb-10 md:pt-12 md:pb-14">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm">
          {breadcrumbs.map((item, idx) => (
            <li class="flex items-center gap-1.5">
              {idx === breadcrumbs.length - 1 ? (
                <span class="px-3 py-1 rounded-full bg-ink-900 text-white font-bold border-2 border-ink-900">{item.name}</span>
              ) : (
                <>
                  <a href={item.url} class="px-3 py-1 rounded-full bg-white border-2 border-ink-200 text-ink-700 font-semibold hover:border-ink-900 hover:text-ink-900 no-underline transition-colors">{item.name}</a>
                  <svg class="w-3 h-3 text-ink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </>
              )}
            </li>
          ))}
        </ol>
      </nav>

      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-2 mb-5">
          <span class="chip-lime">📈 Top-up SIP</span>
          <span class="chip-cyan">💰 Mutual fund</span>
          <span class="chip-white"><span class="text-ink-500">Updated</span><span>{meta.lastUpdated}</span></span>
        </div>

        <h1 class="!text-4xl sm:!text-5xl md:!text-6xl !font-extrabold !tracking-tight !leading-[1.05] text-ink-900" style="font-family: 'Inter Tight', sans-serif; letter-spacing: -0.035em;">
          Step-Up SIP Calculator.
          <span class="text-gradient-brand">Raise your SIP, grow your corpus.</span>
        </h1>

        <div class="speakable-answer mt-7 bg-yellow-accent border-[2.5px] border-ink-900 rounded-2xl p-5 shadow-sticker">
          <div class="flex items-start gap-3">
            <div class="text-2xl">⚡</div>
            <div>
              <div class="text-xs font-extrabold uppercase tracking-wider text-ink-900 mb-1">Quick answer</div>
              <p class="text-ink-900 text-base sm:text-lg leading-relaxed font-medium !m-0">
                A <strong>₹10,000/month</strong> SIP with a <strong>10% annual step-up</strong> at <strong>12% return</strong> over <strong>10 years</strong> grows to about <strong>₹33,74,326</strong> from <strong>₹19,12,491</strong> invested (your monthly SIP climbs to ~₹23,579 by year 10). A flat ₹10,000 SIP over the same period builds only <strong>₹23,23,391</strong>. The step-up adds roughly <strong>₹10.5 lakh more</strong> corpus. Returns are illustrative, not guaranteed.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide pb-12 md:pb-16">
    <div class="max-w-4xl mx-auto">
      <StepUpSipCalculator client:visible />
    </div>
  </section>


  <section class="bg-ink-50 border-y-2 border-ink-900">
    <div class="container-wide py-12 md:py-16">
      <div class="max-w-4xl mx-auto">
        <span class="chip-cyan mb-4">📊 How step-up SIPs work</span>
        <h2 class="!text-3xl sm:!text-4xl !mt-4 !leading-tight" style="font-family: 'Inter Tight', sans-serif;">
          Why a rising SIP finishes so far ahead.
        </h2>

        <div class="mt-8 prose prose-lg max-w-none">
          <p class="text-ink-700 leading-relaxed font-medium">
            A step-up SIP (also called a top-up SIP) starts at an amount you can afford today and raises it by a fixed percentage every year, usually matched to your annual salary hike. That single habit fixes the quiet flaw in a flat SIP: left unchanged, a fixed monthly amount shrinks as a share of a rising income and slowly loses ground to inflation. By stepping the amount up, you keep your saving rate roughly constant and put more capital to work in the early and middle years, when it still has the longest runway to compound.
          </p>
          <p class="text-ink-700 leading-relaxed font-medium">
            The maths compounds on two fronts. Each instalment earns returns for the months left until maturity, and the contribution itself grows geometrically year after year. Because the increases you make early get the most time in the market, the corpus pulls ahead of a flat SIP by more than the extra rupees you actually put in. In the default case above, you invest about ₹7.1 lakh more across ten years but end with roughly ₹10.4 lakh more corpus. For the full breakdown across step-up rates and a 20-year horizon, read the <a href="/guides/sip-step-up-vs-flat/">Step-Up vs Flat SIP guide</a>.
          </p>
          <p class="text-ink-700 leading-relaxed font-medium">
            <strong>Caveats:</strong> every figure here is an illustration built on a constant assumed return. Real mutual fund returns vary year to year and can be negative in any single year, so treat 10 to 12% as a planning estimate rather than a promise. A step-up only delivers if you actually sustain the rising contribution, so pre-commit it on your platform so the increase happens automatically. This is a method of investing, not a guaranteed product, and it is not financial advice.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <span class="chip-cyan mb-4">❓ FAQ</span>
      <h2 class="!text-3xl sm:!text-4xl !mt-4 !leading-tight" style="font-family: 'Inter Tight', sans-serif;">
        Step-up SIP calculator FAQ.
      </h2>

      <div class="mt-8 space-y-4">
        {faqs.map((faq) => (
          <details class="bg-white border-[2.5px] border-ink-900 rounded-2xl p-5 shadow-sticker-sm group">
            <summary class="cursor-pointer font-bold text-ink-900 list-none flex items-start justify-between gap-4">
              <span style="font-family: 'Inter Tight', sans-serif;">{faq.q}</span>
              <span class="text-ink-500 group-open:rotate-180 transition-transform">▾</span>
            </summary>
            <p class="mt-3 text-ink-700 font-medium leading-relaxed !mb-0">{faq.a}</p>
          </details>
        ))}
      </div>

      <div class="mt-10 bg-white border-[2.5px] border-ink-900 rounded-2xl p-6 shadow-sticker-sm">
        <div class="text-xs font-extrabold uppercase tracking-wider text-ink-700 mb-3">Related calculators</div>
        <div class="flex flex-wrap gap-2">
          {relatedCalculators.map((item) => (
            <a href={item.href} class="chip-white no-underline hover:bg-lime-accent transition-colors">{item.label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
